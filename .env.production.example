# Production Environment
# Copy this file to .env.production and fill in your actual values
# SECURITY: Never commit this file with real secrets to version control

# Backend
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://admin:${MONGO_ROOT_PASSWORD}@mongodb:27017/gigflow_prod?authSource=admin
JWT_SECRET=your-secure-jwt-secret-here-min-32-characters
CLIENT_URL=https://your-domain.com

# Frontend
VITE_API_URL=https://your-domain.com/api/v1

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-password-here

# Optional: Use these for container orchestration
# REGISTRY=your-registry.com
# IMAGE_TAG=latest
